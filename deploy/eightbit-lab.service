; systemd *user* unit — keeps the office backend running.
;
;   mkdir -p ~/.config/systemd/user
;   cp deploy/eightbit-lab.service ~/.config/systemd/user/
;   # point WorkingDirectory at where you actually cloned the repo
;   systemctl --user daemon-reload
;   systemctl --user enable --now eightbit-lab
;   journalctl --user -u eightbit-lab -f
;
; To update later: npm run update (waits for idle staff, then pull → build → restart this unit).
;
; To keep it alive across logout and reboot (needs sudo, once):
;   sudo loginctl enable-linger $USER
;
; Note: running it on a Mac and a server at the same time runs routines twice. Run it in one place only.

[Unit]
Description=8-bit Lab office backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/eightbit-lab
; the claude CLI and node must be on PATH (non-interactive shells often miss ~/.local/bin)
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
; give sessions time to shut down cleanly
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=default.target
