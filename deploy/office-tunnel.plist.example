<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.eightbit-lab.tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <!-- the loop does the retrying (launchd holds back a job that keeps exiting quickly). A connection that lasted over a minute is retried after 30 s; one that keeps failing is retried after 30 s, 1, 2, then every 5 minutes: each try is a new connection, and a network that sees many of them may block the machine -->
    <string>w=30; while :; do s=$(date +%s); /usr/bin/ssh -N office-tunnel; d=$(( $(date +%s) - s )); if [ $d -gt 60 ]; then w=30; fi; sleep $w; if [ $d -le 60 ]; then w=$(( w * 2 )); if [ $w -gt 300 ]; then w=300; fi; fi; done</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/tmp/office-tunnel.log</string>
  <key>StandardErrorPath</key><string>/tmp/office-tunnel.log</string>
</dict>
</plist>
