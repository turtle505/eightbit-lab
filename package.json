{
  "name": "eightbit-lab",
  "private": true,
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "docx": "^9.16.0",
    "dompurify": "^3.5.0",
    "marked": "^18.2.1",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "license": "MIT",
  "description": "8-bit Lab: a pixel-art office for running Claude Code agents on research and daily tasks",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node scripts/check-node.mjs && tsx watch server/src/index.ts",
    "dev:web": "vite web",
    "build": "vite build web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "start": "node scripts/check-node.mjs && tsx server/src/index.ts",
    "update": "tsx scripts/update.ts",
    "notify:test": "tsx scripts/notify-test.ts"
  }
}
